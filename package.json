{
  "name": "open-usage",
  "version": "0.2.0",
  "description": "A terminal dashboard for unified AI plan usage across Claude Code, Codex, and OpenCode Go",
  "type": "module",
  "license": "GPL-3.0-only",
  "bin": {
    "open-usage": "bin/open-usage.js"
  },
  "files": [
    "bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arionrefat/open-usage.git"
  },
  "homepage": "https://github.com/arionrefat/open-usage",
  "bugs": {
    "url": "https://github.com/arionrefat/open-usage/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "usage",
    "limits",
    "terminal",
    "tui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "bun --watch src/index.tsx",
    "demo": "NODE_ENV=production bun src/index.tsx --mock --no-poll",
    "production": "NODE_ENV=production bun src/index.tsx",
    "preview": "bun scripts/preview.tsx",
    "shot": "bun scripts/shot.tsx",
    "build": "bun build --compile --minify src/index.tsx --outfile dist/open-usage",
    "build:npm": "bun scripts/build-npm-packages.ts",
    "version:set": "bun scripts/set-version.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "@types/bun": "latest",
    "@types/react": "^19",
    "react": "^19.2.6",
    "typescript": "^5"
  }
}
