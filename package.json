{
  "name": "open-usage",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.tsx",
    "limit": "NODE_ENV=production bun src/index.tsx --mock --no-poll",
    "production": "NODE_ENV=production bun src/index.tsx",
    "preview": "bun scripts/preview.tsx",
    "shot": "bun scripts/shot.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/react": "^0.4.5",
    "react": "^19.2.6"
  }
}
