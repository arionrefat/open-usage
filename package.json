{
  "name": "open-usage",
  "version": "0.3.1",
  "description": "A terminal dashboard for unified AI plan usage across Claude Code, Codex, and OpenCode Go",
  "module": "src/index.tsx",
  "type": "module",
  "license": "GPL-3.0-only",
  "bin": {
    "limitless": "src/index.tsx"
  },
  "files": [
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arionrefat/open-usage.git"
  },
  "homepage": "https://github.com/arionrefat/open-usage",
  "bugs": {
    "url": "https://github.com/arionrefat/open-usage/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "usage",
    "limits",
    "terminal",
    "tui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.tsx",
    "limitless": "NODE_ENV=production bun src/index.tsx --mock --no-poll",
    "production": "NODE_ENV=production bun src/index.tsx",
    "preview": "bun scripts/preview.tsx",
    "shot": "bun scripts/shot.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "typescript": "^5"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/react": "^0.4.5",
    "react": "^19.2.6"
  }
}
